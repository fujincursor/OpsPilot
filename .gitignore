# Environment
# ===================
.env
.env.local
.env.*.local
*.env

# ===================
# Python
# ===================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
.virtualenv/

# PyInstaller
*.manifest
*.spec

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ===================
# Node.js / Frontend
# ===================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.nuxt/

# Cache
.cache/
.parcel-cache/
.turbo/

# TypeScript
*.tsbuildinfo

# Vite
*.local

# ===================
# IDE / Editors
# ===================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# JetBrains
*.iml
*.ipr
*.iws
.idea_modules/

# ===================
# OS Files
# ===================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.lnk

# ===================
# Docker
# ===================
docker/init-scripts/*.sql
docker/nginx/ssl/
!docker/nginx/ssl/.gitkeep

# ===================
# Logs
# ===================
logs/
*.log
log/

# ===================
# Database
# ===================
*.sqlite
*.sqlite3
*.db
backups/*.sql

# ===================
# Secrets & Credentials
# ===================
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
.secrets

# ===================
# Generated Files
# ===================
*.generated.*
coverage/
reports/
.nyc_output/

# ===================
# Temporary Files
# ===================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ===================
# Project Specific
# ===================
# DeerFlow framework (cloned separately)
deerflow/

# OpsPilot data directory
.opspilot/

# Knowledge base uploads
uploads/
storage/

# AI model caches
models/
!backend/src/models/
embeddings_cache/

# Test artifacts
test-results/
playwright-report/
test-screenshots/

# Sandbox workspaces
sandbox-workspace/
