# OpsPilot Environment Configuration
# ====================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ===================
# Application Settings
# ===================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=your-secret-key-change-in-production

# ===================
# API Configuration
# ===================
API_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ===================
# Database (PostgreSQL)
# ===================
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://opspilot:opspilot@postgres:5432/opspilot

# ===================
# Redis Cache
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ===================
# Milvus Vector Database
# ===================
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ===================
# MinIO Object Storage
# ===================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000

# ===================
# AI/LLM Configuration
# ===================
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Azure OpenAI (alternative)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=

# Local LLM (alternative)
LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL=

# ===================
# Embedding Configuration
# ===================
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# ===================
# Sandbox Configuration
# ===================
SANDBOX_MODE=development
EXECUTION_TIMEOUT=300
MEMORY_LIMIT=512m

# ===================
# Authentication
# ===================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================
# External Services
# ===================
# Git Integration
GIT_DEFAULT_BRANCH=main
GITHUB_TOKEN=

# Notification
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@opspilot.local

# ===================
# Monitoring
# ===================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ===================
# Frontend (Vite)
# ===================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE=OpsPilot
